# Laravel Project Inspector - AI settings.
#
# Copy to .env (or run "larainspect config:init") and fill in what you use.
# Environment variables with the same names override this file.
# This file belongs to the inspector, never to the project being inspected.
# Never commit the real .env: it is git-ignored.

# Provider used when --provider is not given: anthropic, openai, openrouter, notokenlimit
AI_PROVIDER=
# Model for AI_PROVIDER when <PROVIDER>_MODEL is not set
AI_MODEL=
# Run AI analysis on every inspect/report without --ai (false = only when asked)
AI_ENABLED=false
# Request timeout in seconds, output token limit, retries on 429/5xx/timeouts
AI_TIMEOUT=300
AI_MAX_TOKENS=16000
AI_MAX_RETRIES=2
# Upper bound for the inspection data sent per AI task, in characters
AI_MAX_INPUT_CHARS=60000

# --- Anthropic (https://console.anthropic.com) ---------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# Default: claude-opus-5-5
ANTHROPIC_MODEL=
# API version header (default 2026-10-21)
ANTHROPIC_VERSION=
# Optional: low, medium, high, xhigh, max (unset = the model's default)
ANTHROPIC_EFFORT=
# Server-side refusal fallback for models that support it (default true)
ANTHROPIC_REFUSAL_FALLBACK=

# --- OpenAI (https://platform.openai.com) --------------------------------------
OPENAI_API_KEY=
# Override to use an OpenAI-compatible server (Azure, local gateway)
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
# Set to max_tokens for OpenAI-compatible servers that do not support max_completion_tokens
OPENAI_TOKEN_PARAMETER=

# --- OpenRouter (https://openrouter.ai) ----------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
# e.g. anthropic/claude-opus-5.5 (list with "larainspect ai:models openrouter")
OPENROUTER_MODEL=
# Optional attribution headers
OPENROUTER_APP_NAME=
OPENROUTER_APP_URL=

# --- NoTokenLimit (https://notokenlimit.com) -----------------------------------
# Third-party reseller, not affiliated with the model vendors.
NOTOKENLIMIT_API_KEY=
NOTOKENLIMIT_BASE_URL=
# e.g. claude-sonnet-5.5 (list with "larainspect ai:models notokenlimit")
NOTOKENLIMIT_MODEL=
